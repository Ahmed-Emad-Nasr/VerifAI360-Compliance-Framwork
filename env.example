# Copy this file to .env and fill in your real key.
# Get a FREE key (no credit card required) at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL: add a second (or third, etc.) key from a different Google
# account to get automatic failover when one account's free-tier quota
# runs out (HTTP 429). Either format works:
#
#   GOOGLE_API_KEY_2=AIzaSy...second-account-key...
#   GOOGLE_API_KEY_3=AIzaSy...third-account-key...
#
# or as a single comma-separated list:
#   GOOGLE_API_KEYS=AIzaSy...key1...,AIzaSy...key2...
#
# Free-tier quota limits can change over time — check
# https://ai.google.dev/gemini-api/docs/rate-limits for current limits.
