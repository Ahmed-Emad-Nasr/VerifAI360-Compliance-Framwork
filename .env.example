# Copy this file to .env and fill in your real values.
# `.env` itself is git-ignored (see .gitignore) — never commit your real keys.

# ---------------------------------------------------------------------------
# REQUIRED: Google Gemini API key (only needed if you use the "AI" analysis
# engine — the "Local" offline engine needs no API key at all).
# Get a FREE key (no credit card required) at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL: add a second (or third, etc.) key from a different Google account
# to get automatic failover when one account's free-tier quota runs out
# (HTTP 429). Either format works:
#
#   GOOGLE_API_KEY_2=AIzaSy...second-account-key...
#   GOOGLE_API_KEY_3=AIzaSy...third-account-key...
#
# or as a single comma-separated list:
#   GOOGLE_API_KEYS=AIzaSy...key1...,AIzaSy...key2...
#
# Free-tier quota limits can change over time — check
# https://ai.google.dev/gemini-api/docs/rate-limits for current limits.

# ---------------------------------------------------------------------------
# OPTIONAL: only needed if Tesseract OCR isn't auto-detected on your system
# (see the Setup section in README.md). Full path to the tesseract binary.
# ---------------------------------------------------------------------------
# TESSERACT_CMD=/usr/local/bin/tesseract

# ---------------------------------------------------------------------------
# AUTO-GENERATED on first run if not set here — you don't need to fill these
# in yourself. Listed for reference / so you know these keys exist:
#
#   APP_PASSCODE     — the shared passcode required to open the app.
#   ENCRYPTION_KEY   — the Fernet key used to encrypt evidence at rest.
#                      Losing this makes existing encrypted evidence
#                      unrecoverable by design — back it up separately
#                      from verifai360.db, not alongside it.
# ---------------------------------------------------------------------------
